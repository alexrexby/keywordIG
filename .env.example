# Образец окружения установки. Копия этого файла с заполненными значениями — то, чем
# живёт сервис. Значений здесь нет и быть не должно: репозиторий публичный.
#
# Секреты генерируются, а не придумываются: hex и token_urlsafe переживают копипасту,
# URL-кодирование и разбор строки подключения, а придуманный пароль со знаком @ или /
# эту строку рвёт — и отказ выглядит как «неверный пароль».

# Обычный путь — ./scripts/install.sh: он спрашивает то, что знает только человек,
# генерирует секреты нужного вида и создаёт рабочий файл сам, а существующий не трогает.
# Этот образец нужен, когда файл правят руками: что означает поле и чем его заполнять.
# Проверить установку после правки: ./scripts/update.sh, затем ./scripts/doctor.sh

# --- домен ---
# Домен установки, БЕЗ схемы и слэша. На него Caddy получает сертификат, его же вы
# понесёте в дашборд Meta как callback URL. A-запись должна указывать сюда ДО первого
# запуска: без неё сертификат не выдадут, а выглядеть это будет как «сервис не работает».
IG_DOMAIN=

# --- база ---
# Два РАЗНЫХ значения, оба: openssl rand -hex 32
# Только hex: пароль попадает в адрес подключения
# postgresql://ig_service:<пароль>@postgres:5432/ig, и любой из символов @ : / # % ?
# рвёт его разбор.
#
# Пароль роли, под которой работает сервис. У неё нет прав на схему public.
IG_DB_PASSWORD=
# Пароль суперюзера базы. Сервис его не знает и не использует — он нужен вам, если
# понадобится зайти в базу самому. Тот же секрет на обе роли отменил бы разделение прав:
# кто прочитал строку подключения сервиса, тот и суперюзер.
# На уже созданной базе смена этого значения ничего не меняет — только ALTER ROLE внутри.
IG_DB_SUPERUSER_PASSWORD=

# --- приложение Meta ---
# App Secret приложения (Settings -> Basic). Им подписан каждый вебхук; пустое значение
# НЕ открывает приём, а закрывает его целиком.
IG_APP_SECRET=
# Строка, которую вы придумываете сами и вводите в дашборде рядом с callback URL.
# Meta вернёт её в query-строке проверки — значит, только ASCII без пробелов:
#   python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
IG_VERIFY_TOKEN=
# Идентификатор вашего Instagram-аккаунта — тот, что виден в поле entry.id вебхука.
# По нему сервис отличает свои события от чужих и свои комментарии от людских.
IG_USER_ID=
# Долгоживущий токен доступа (Instagram Business Login). Нужен ТОЛЬКО для первого засева:
# дальше источник правды — база, сервис продлевает токен сам, а это значение устаревает
# на второй день и больше не читается. Менять токен потом — в панели, не здесь.
IG_ACCESS_TOKEN=
# Версия Graph API в адресах запросов. Meta выводит версии из обращения примерно раз в год.
IG_GRAPH_VERSION=v25.0

# --- ключи сервиса ---
# python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
# Ключ конверта, которым токен доступа шифруется в базе. Потеряете — токен не
# расшифруется, и выдавать его придётся заново.
IG_TOKEN_KEY=
# python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
# Ключ машинного API /ig/admin/*. Пустое значение закрывает эти роуты целиком.
IG_ADMIN_TOKEN=

# --- канал аварийных сообщений ---
# Все отказы этой механики молчаливые: отсутствие ответа в директе никто не наблюдает.
# Без рабочего канала вы узнаете о поломке от подписчиков, а не от сервиса.
# Токен бота даёт @BotFather в Telegram, выглядит как 123456789:AA...
IG_ALERT_BOT_TOKEN=
# Куда слать: ваш chat_id или id группы (у групп он с минусом). Только цифры.
# Свой id покажет @userinfobot; боту нужно написать первым, иначе он не ответит вам.
IG_ALERT_CHAT_ID=

# --- предохранители отправки ---
# Темп: сообщений в минуту. Виральный пост не должен упереть аккаунт в лимиты Meta.
IG_DISPATCH_RATE=20
# Объём: сообщений в сутки, 0 — снять ограничение.
# 20 и 50 — значения на ПЕРВУЮ кампанию. Рискует ваш аккаунт, а не сервер: сотня
# автоматических сообщений незнакомым людям за час — ровно тот профиль, который платформа
# ловит как спам. Поднять число, увидев живую механику, дешевле, чем объясняться с Meta.
IG_DAILY_DM_LIMIT=50

# --- панель ---
# Панель живёт на https://<домен>/panel — из неё чинят установку, в том числе с телефона.
# python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
# Ключ подписи сессии. Пустое значение панель не открывает, а закрывает целиком.
IG_ADMIN_SECRET=
# ХЕШ пароля, а не пароль. Посчитать, не сохраняя пароль в истории шелла:
#   docker compose -f docker-compose.prod.yml run --rm --no-deps instagram-service \
#     python panel.py
# (команда ждёт пароль со STDIN и печатает строку вида scrypt:16384:8:1:<соль>:<хеш>)
# Разделитель здесь двоеточие, а не привычный у scrypt доллар, и это намеренно:
# доллар в значении docker compose принимает за имя переменной и молча съедает
# часть строки — панель после этого закрывается, а причина ниоткуда не видна.
IG_ADMIN_PASSWORD_HASH=

# --- хранение данных ---
# Сколько суток живут карточки обращений: кто написал, что написал, что ему ответили.
# ЭТО ЖЕ ЧИСЛО ПЕЧАТАЕТ ПУБЛИЧНАЯ ПОЛИТИКА КОНФИДЕНЦИАЛЬНОСТИ — источник один, чтобы
# документ не обещал того, чего сервис не делает. 0 — не удалять ничего; страница
# в этом случае честно пишет «храним, пока работает сервис».
# Отметки «этому человеку материал уже выдавали» чистка не трогает: без них тот же
# человек получил бы материал второй раз, а «дважды не отправляем» обещано в политике.
IG_DELIVERY_RETENTION_DAYS=365

# --- реквизиты для публичных страниц ---
# Их печатают /privacy и /data-deletion. Без первых четырёх страницы отдают 503 с
# перечнем незаполненного — и это намеренно: политику с пустотой на месте имени
# владельца принимает дашборд Meta, и она остаётся публичным лицом установки навсегда.
# Пустой privacy policy URL при этом блокирует публикацию приложения, а без публикации
# не приходят уведомления о комментариях.
#
# Как называется то, что стоит на этом домене: «Автоответы @имя_аккаунта».
OWNER_SERVICE_NAME=
# Сам аккаунт в Instagram, вместе с собакой: @имя_аккаунта
OWNER_ACCOUNT=
# Кто отвечает за данные: юрлицо, ИП или человек. «ИП Иванов Иван Иванович».
OWNER_LEGAL_NAME=
# Почта для обращений. Её читает живой человек и на неё приходят просьбы удалить данные.
OWNER_CONTACT_EMAIL=
# Необязательные: пустые — строка про них просто не печатается.
# ИНН или местный аналог; у частного лица его может не быть, и это законно.
OWNER_TAX_ID=
# Адрес для бумажной почты. Пусто — страница пишет «дадим по запросу».
OWNER_ADDRESS=
# Дата действующей редакции: «26 августа 2026». Пусто — строки «Обновлено» не будет.
OWNER_POLICY_UPDATED=
