# Прокси установки: TLS, лимит тела, закрытая снаружи админка.
#
# КАТАЛОГ, А НЕ ФАЙЛ. В docker-compose смонтирован весь ./caddy, и это не стилистика.
# Bind-mount ОДИНОЧНОГО файла держится за inode: `git pull` подменяет файл целиком,
# контейнер продолжает читать старую версию, а `caddy reload` честно возвращает ноль —
# он перечитал то, что видит. Отказ выглядит как «на диске новое, работает старое»
# и не находится ничем, кроме наблюдаемого эффекта.
#
# Домен подставляется из окружения (IG_DOMAIN). Пустое значение — это не «любой хост»:
# Caddy откажется стартовать, и вы увидите ошибку сразу, а не через два дня по молчанию.

{$IG_DOMAIN} {
	# Машинное админ-API из интернета не нужно никому: ходят в него по docker-сети
	# (instagram-service:8020), мимо прокси. Ключ IG_ADMIN_TOKEN остаётся воротами
	# приложения, а это рубеж ПЕРЕД приложением — на случай, если ключ утечёт.
	# Блок стоит ВЫШЕ handle /ig/*: handle-блоки взаимоисключающие, и порядок здесь
	# виден глазами, а не выводится из правил сортировки.
	#
	# Признак, что прокси применился, — 403 с ПУСТЫМ телом. Непустое тело означает, что
	# запрос дошёл до приложения (у FastAPI 403 приходит с JSON), то есть конфиг НЕ тот.
	handle /ig/admin/* {
		respond 403
	}

	# handle, а не handle_path: префикс /ig не срезаем — сервис сам смонтирован
	# на /ig/..., и локальный localhost:8020/ig/webhook совпадает с прод-адресом.
	handle /ig/* {
		# Первый рубеж по размеру тела: до приложения и до его памяти.
		# 256KiB = 262144 байта, ровно MAX_BODY_BYTES в main.py. Именно KiB:
		# «256KB» Caddy трактует как 256000, и рассинхрон даёт плавающие 413.
		request_body {
			max_size 256KiB
		}
		reverse_proxy instagram-service:8020
	}

	# Всё остальное — тому же сервису. Сейчас он отвечает на эти адреса 404, и это
	# правильный ответ: публичных страниц у него пока нет. Маршрут заведён заранее,
	# чтобы страницы политики и панель не требовали правки прокси, — а интерактивная
	# схема API отсюда не видна, она выключена в самом приложении (main.py).
	handle {
		reverse_proxy instagram-service:8020
	}
}
