# Секреты установки. Файл создаёт install.sh и НИКОГДА не перезаписывает существующий.
.env
.env.local
# Черновик того же файла: install.sh пишет секреты сюда и переименовывает одним действием.
# Обычно живёт секунды, но обрыв установки оставляет его на диске — в git ему не место.
.env-draft.*

__pycache__/
*.pyc
